<IfModule mod_headers.c>
  # 1. Strict-Transport-Security (HSTS)
  # Forces browsers to only connect over HTTPS. 
  # max-age is 1 year (31536000 seconds).
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # 2. X-Frame-Options
  # Prevents clickjacking by restricting where the site can be embedded in an iframe.
  Header always set X-Frame-Options "SAMEORIGIN"

  # 3. X-Content-Type-Options
  # Prevents MIME-sniffing. The browser will strictly follow the provided Content-Type.
  Header always set X-Content-Type-Options "nosniff"

  # 4. Referrer-Policy
  # Controls how much referrer information is included with requests.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # 5. Permissions-Policy
  # Disables access to sensitive browser features (like camera, microphone, geolocation) by default.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Proxy /api/chat directly to our PHP proxy script on Hostinger
  RewriteRule ^api/chat/?$ chat-proxy.php [L]

  # 2. React Router Fallback: Redirect all other requests to index.html
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
